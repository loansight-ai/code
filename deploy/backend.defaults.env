# Compose development defaults; these values are not approved production policies.
# backend/.env overrides this file. Connection URLs remain in compose.yaml.
LOANSIGHT_DATABASE_TIMEOUT_SECONDS=3
LOANSIGHT_SESSION_TTL_SECONDS=86400
LOANSIGHT_ENTRY_WINDOW_SECONDS=60
LOANSIGHT_ENTRY_IP_LIMIT=30
LOANSIGHT_ENTRY_CODE_LIMIT=10
LOANSIGHT_ENTRY_GLOBAL_LIMIT=100
LOANSIGHT_JOB_MAX_ATTEMPTS=3
LOANSIGHT_COOKIE_SECURE=false
LOANSIGHT_TASK_EVENTS_ENABLED=true
LOANSIGHT_ALLOWED_ORIGINS=["http://localhost:${LOANSIGHT_API_PORT:-8000}","http://127.0.0.1:${LOANSIGHT_API_PORT:-8000}","http://localhost:${LOANSIGHT_FRONTEND_PORT:-5173}","http://127.0.0.1:${LOANSIGHT_FRONTEND_PORT:-5173}","https://kb-bridge.sjw-project.site"]
