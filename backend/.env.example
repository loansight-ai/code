# Copy to backend/.env; all values below are local examples.
LOANSIGHT_DATABASE_URL=postgresql+psycopg://loansight:local-example@localhost:5432/loansight
LOANSIGHT_DATABASE_TIMEOUT_SECONDS=3
# Native API/Worker must use the same persistent artifact directory.
LOANSIGHT_ARTIFACT_ROOT=.run/artifacts
# Technical upload size cap in bytes (20 MiB), not a business policy threshold.
LOANSIGHT_NOTE_IMPORT_MAX_BYTES=20971520
# Local development examples only; production policies are undecided.
LOANSIGHT_SESSION_TTL_SECONDS=86400
LOANSIGHT_ENTRY_WINDOW_SECONDS=60
LOANSIGHT_ENTRY_IP_LIMIT=30
LOANSIGHT_ENTRY_CODE_LIMIT=10
LOANSIGHT_ENTRY_GLOBAL_LIMIT=100
LOANSIGHT_JOB_MAX_ATTEMPTS=3
LOANSIGHT_COOKIE_SECURE=false
LOANSIGHT_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
LOANSIGHT_TASK_EVENTS_ENABLED=true
# For native Worker/Relay only: supply an independently reachable broker.
# LOANSIGHT_RABBITMQ_URL=amqp://loansight:local-example@localhost:5672/

# 활용 API key
open_dart_api_key=
ecos_api_key=
open_data_api_key=
